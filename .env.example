# Laravel public API (server-side only; never exposed to the browser)
API_BASE_URL=http://localhost:8000/api/v1

# Public canonical origin of this storefront (used for canonical URLs, sitemap, Open Graph)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Comma-separated hostnames allowed for product images
IMAGE_HOSTS=res.cloudinary.com

# Optional brand overrides (see lib/brand.ts)
# NEXT_PUBLIC_APP_NAME=
# NEXT_PUBLIC_APP_SHORT_NAME=
# NEXT_PUBLIC_APP_DESCRIPTION=
# NEXT_PUBLIC_THEME_COLOR=
# NEXT_PUBLIC_BACKGROUND_COLOR=

# Development only: shows the simulated payment page at /dev/pay/<reference> (the API needs PAYMENTS_FAKE_GATEWAY=true too).
# ENABLE_FAKE_PAYMENTS=1
